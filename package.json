{
  "name": "orbitmenu",
  "productName": "OrbitMenu",
  "version": "0.2.3",
  "description": "A fast radial launcher for Windows: open a pie menu at the cursor and run apps, shortcuts, snippets and macros with clicks or gestures.",
  "main": "dist/main/index.js",
  "author": "OrbitMenu contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/build.mjs && electron-forge package",
    "make": "node scripts/build.mjs && electron-forge make",
    "selftest": "node scripts/selftest.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "koffi": "~2.16.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "koffi@2.16.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.4": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ariapiacere/orbitmenu.git"
  },
  "orbitmenu": {
    "updateRepository": "ariapiacere/orbitmenu"
  }
}
